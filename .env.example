FRONTEND_PORT=3000
BACKEND_UPSTREAM=host.docker.internal:8000

VITE_BRAND_NAME=StatusGate
# VITE_BRAND_LOGO_URL=/logo.svg
# VITE_BRAND_LOGO_URL_LIGHT=/logo-light.svg
# VITE_BRAND_LOGO_URL_DARK=/logo-dark.svg
# Missing logo file falls back to /favicon.svg in the UI.
VITE_BRAND_TAGLINE=Service status monitoring

# Network probes / speed test placeholders (optional; hardcoded fallbacks when unset).
# Prefer the same values as backend DEFAULT_* / INTERNET_PING_HOST so UI defaults match.
# VITE_DEFAULT_SPEED_TEST_URL_TEMPLATE=https://speed.cloudflare.com/__down?bytes={bytes}
# VITE_CLOUDFLARE_SPEED_TEST_ORIGIN=https://speed.cloudflare.com
# VITE_DEFAULT_PROBE_URL=https://ifconfig.me/ip
# VITE_INTERNET_PING_HOST=8.8.8.8
