{
  "name": "frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript-7/bin/tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc -b --pretty",
    "typecheck:eslint": "tsc -b --pretty",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:export": "docker run --rm -v \"$(pwd)/..:/repo\" -w /repo/backend -e JWT_SECRET=export-openapi-local-dev-secret-32chars statusgate-backend-test python scripts/export_openapi.py",
    "api:generate": "orval",
    "api:sync": "npm run api:export && npm run api:generate"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "orval": "^8.24.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.1"
  }
}
